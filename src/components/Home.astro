---
import { Image } from 'astro:assets';
import FunkturmLogo from '../assets/funkturm_logo_weiß.svg';
import Menu from './Menu.astro';
import  HomeImages  from './HomeImages.astro';
import  HappyCarousel  from './CssCarousel.astro';
import  ImageCarousel  from './ImageCarousel.astro';
import stack from '../assets/stack_big.jpeg';
import Socials from '@blocks/Socials/Socials.astro'

const images = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/home_gallery/*.{jpeg,png,webp}", { eager: true })
).map(([path, m]) => ({ src: m.default, alt: "" }));
---

<Menu />
<div id="socials">
	<Socials links={['https://instagram.com/funkturm.wien']} size={32} color="#fff"/>
</div>
<div id="container">
	<div id="spacer"> </div>
	<div id="logo_container">
		<a href="/">
			<FunkturmLogo id="FunkturmLogo"/>
		</a>
	</div>
	<div id="text_container">
		<p id="description"> Sound System </p>
	</div>
	<div id="filler"> </div>
	<div id="carousel_container">
			<!-- <HappyCarousel />  -->
		<!-- <HomeImages /> -->
		<ImageCarousel images={images}/>
	</div>
	<div id="filler"> </div>
	<div id="stack_container">
		<Image id="stack" src={stack} alt="Nonin"/>
	</div>
</div>

<style>
	#socials {
		position: fixed;
		margin: 1.2rem;
	}
	
	#container {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100vh;
		height: 100dvh;

		background: radial-gradient(circle at top, #131013, #070707);;
	}

	#spacer {
		flex: 0 0 4rem;
	}


	#logo_container {
		flex: 0 0 auto;
		margin: 0 auto;
		padding: 0 2rem;
		/* padding: min(1.5rem, 20vh) 2rem 4rem 2rem; */
	}

	#carousel_container {
		flex: 1 1 0;
		margin: 0 auto;
		max-width: 100vmin;
		min-height: 20vh;
	}
	#FunkturmLogo {
		width: 100%;
		max-width: 60vmin;
		height: auto;
	}

	#text_container {
		flex: 0 0 auto;
	}

	#filler {
		flex: 1 1 0;      /* grows into all leftover space */
		min-height: 0;
	}

	#description {
		width: 80vmin;
		margin: 0 auto;
		text-align: center;
	}

	#stack_container  {
		flex: 0 1 auto;
		min-height: 0;
		width: 100%;
		max-width: 70vmin;
		margin: auto;
		mix-blend-mode: lighten;
		opacity: 0.88;
	}

	#stack_container > * {
		width: 100%;
		height: auto;
		margin: auto;
		object-fit: contain;
	}
	

  	@media (max-width: 700px) {
		#carousel_container {
			max-height: 30vh;
		}

		#stack_container {
			max-width: 100vw;
		}
	}



</style>
