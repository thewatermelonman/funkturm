---
import { Image } from 'astro:assets';
import FunkturmLogo from '../assets/funkturm_logo_weiß.svg';
import Menu from './Menu.astro';
import stack from '../assets/stack_big.jpeg';
import one from '../assets/one.jpeg';
import two from '../assets/two.jpeg';
import three from '../assets/three.jpeg';
import { Carousel} from 'webcoreui/astro'
import Socials from '@blocks/Socials/Socials.astro'
---

<Menu />
<div id="socials">
	<Socials links={['https://instagram.com/funkturm.wien']} size={32} color="#fff"/>
</div>
<div id="container">
		<div id="FunkturmLogo_container">
			<a href="/">
				<FunkturmLogo id="FunkturmLogo"/>
			</a>
		</div>
	<div id="center">
		<div id="carousel">
			<Carousel  items={0} itemsPerSlide={2} pagination={{ type: 'dots' }}>
			<li><Image class="image" id="one" src={one} alt="Nonin"/></li>
				<li><Image class="image" id="two" src={two} alt="Nonin"/></li>
				<li><Image class="image" id="three" src={three} alt="Nonin"/></li>
			</Carousel>
		</div>
		<p id="description">
		Lorem Ipsum is simply dummy text of the printing and typesetting industry. 
		Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley.
		</p>
	</div>
	<div id="funkturm_stack">
		<Image id="stack" src={stack} alt="Nonin"/>
	</div>
</div>

<style>
	#socials {
		position: absolute;
		margin: 1.2rem;
	}
	#FunkturmLogo_container {
		max-width: 20vh;
		margin: 1.5rem auto;
		width: 70vmin;
		padding: 0 2rem;
		/* padding: min(1.5rem, 20vh) 2rem 4rem 2rem; */
	}

	#center {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		margin: 1rem;
		padding: 2rem;
	}
	
	#description {
		width: 70vmin;
		height: 10vh;
		margin: 0 auto;
		margin-top: 2rem;
		text-align: center;
	}

	#carousel {
		flex-grow: 1;
		width: 80vmin;
		margin: 0 auto;
	}

	.image {
		display: block;
		width: auto;
		height: 20vmin;	
	}
	#funkturm_stack  {
		mix-blend-mode: lighten;
		opacity: 0.88;
	}

	#funkturm_stack > * {
		width: min(100vmin, 60vh);
		height: auto;
		display: block;
		margin: auto;
		margin-bottom: 1.5rem;
	}
	
	#container {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
	}


</style>
