---
import { Image } from 'astro:assets';
import FunkturmLogo from '../assets/funkturm_logo_weiß.svg';
import NavBar from './NavBar.astro';
import HamburgerMenu from './HamburgerMenu.astro';

import stack from '../assets/stack_big.jpeg';
---

<HamburgerMenu>
	<NavBar></NavBar>
</HamburgerMenu>
<div id="container">
	<div id="FunkturmLogo_container">
		<a href="/">
			<FunkturmLogo id="FunkturmLogo"/>
		</a>
	</div>
	<div id="home_gallery">
		<Image id="stack" src={stack} alt="Nonin"/>
	</div>
</div>

<style>
	#FunkturmLogo_container {
		max-width: min(20rem, 80vh);
		margin: 1.5rem auto;
		width: 70vmin;
		padding: 0 2rem;
		/* padding: min(1.5rem, 20vh) 2rem 4rem 2rem; */
	}

	#home_gallery  {
		mix-blend-mode: lighten;
		opacity: 0.88;
	}
	#home_gallery > * {
		width: 100vmin;
		height: auto;
		display: block;
		margin: auto;
		margin-bottom: 1.5rem;
	}
	#container {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
	}


</style>
