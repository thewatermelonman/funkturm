---
import DoubleButton from './astro-kit/DoubleButton.astro';
import MinimalPillButton from './astro-kit/MinimalPillButton.astro';
const {item_name} = Astro.props;
---

<div id='NavItem'>
	<MinimalPillButton size="lg" variant='primary'>{item_name}</MinimalPillButton>
</div>

<style>
	#NavItem {
		display: inline;
		font-family: var(--font-nulshock);
		padding-bottom: 2rem;
	}

	#NavItem > button {
		background-color: transparent;
		color: #ffffff;
		font-family: var(--font-nulshock);
		border-radius: 2px;
		border-style: solid;
	}

	#NavItem > button:hover {
		margin: 2px;
	}
</style>
