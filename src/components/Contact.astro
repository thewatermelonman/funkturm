---
import Card from './astro-kit/Card.astro';
import Menu from './Menu.astro';
import MiniLogo from './MiniLogo.astro';
import ContactForm from './ContactForm.astro';
---

<div id="contact_container">
	<Menu />
	<MiniLogo />
	<div id="contact_card">
		<Card title="Contact" padding="lg">
			<h3>Email</h3>
			<h3>Mobil</h3>
			<h3></h3>
		</Card>
	</div>
	<div id="form_card">
		<ContactForm />	
	</div>

	<div id="placeholder_1">
	</div>
</div>


<style>

	#contact_container {
		width: 80vmin;
		min-width: 12rem;
		margin: auto;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin: auto;
	}

	#contact_card {
		font-family: Helvetica;
		padding-top: 1rem;
		color: #aaaaaa;
	}
	#form_card {
		font-family: Helvetica;
		padding-top: 2rem;
	}

	#placeholder_1 {
		height: 4rem;
	}
</style>
