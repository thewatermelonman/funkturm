---
import Card from './astro-kit/Card.astro';
import Menu from './Menu.astro';
import MiniLogo from './MiniLogo.astro';
import ContactForm from './ContactForm.astro';
import Socials from '@blocks/Socials/Socials.astro'
---

<Menu />
<div id="contact_container">
	<div><MiniLogo /></div>
	<div id="contact_card">
		<Card title="Contact" padding="lg">
			<h3>Email</h3>
			<div id="social_line">
					<div><h4>funkturm.wien@gmail.com</h4> </div>
			</div>
			<h3>Social</h3>
			<div id="social_line">
				<div><Socials links={['https://instagram.com/funkturm.wien']} size={32} color="#fff"/></div>
				<div><h4>@funkturm.wien</h4></div>
			</div>
			<h3></h3>
		</Card>
	</div>
	<div id="form_card">
		<ContactForm />	
	</div>
	
	<div id="footer">
	</div>
</div>


<style>
	#footer {
		height: 8rem;
	}
	#contact_container {
		width: 80vmin;
		min-width: 12rem;
		margin: auto;
	}

	#social_line {
		display: flex;
	}

	#social_line > div > h4{
		margin: 0.2rem 1.2rem;
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin: auto;
	}

	#contact_card {
		font-family: Helvetica;
		padding-top: 1rem;
		color: #aaaaaa;
	}
	#form_card {
		font-family: Helvetica;
		padding-top: 2rem;
	}
</style>
