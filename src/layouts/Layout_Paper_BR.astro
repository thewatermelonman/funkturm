---

import { Image, Font } from 'astro:assets';
import stack from '../assets/stack.jpeg';
import Paper from '../components/paper-shader/Paper_bluered.jsx';
---
<!doctype html>
<html lang="en">
	<head>
		<Font cssVariable="--font-nulshock"/>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Funkturm Soundsystem</title>
	</head>
	<body>
		<div id="background" ><Paper client:load /></div>
		<slot />
		<!-- <div id="stack_container_l"><Image id="stack" src={stack} alt="Nonin"/></div> -->
		<!-- <div id="stack_container_r"><Image id="stack" src={stack} alt="Nonin"/></div> -->
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: Helvetica;
	}

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: -1;
	}

	#stack_container_l, #stack_container_r {
		position: relative;
	}

	#stack_container_r > #stack {
		width: 30%;
		height: auto;
		margin: 0;
		padding: 0;
		mix-blend-mode: lighten;
		position: fixed;
		bottom: 2rem;
		right: 0rem;
	}
	#stack_container_l > #stack {
		scale: -1 1;
		width: 30%;
		height: auto;
		margin: 0;
		padding: 0;
		mix-blend-mode: lighten;
		position: fixed;
		bottom: 2rem;
		left: 0rem;
	}

</style>
