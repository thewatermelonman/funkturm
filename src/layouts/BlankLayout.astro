---

import { Font } from 'astro:assets';
---
<!doctype html>
<html lang="en">
	<head>
		<Font cssVariable="--font-nulshock"/>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Funkturm Soundsystem</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		background-color: #070707;

	}

</style>
<style lang="scss">
    @use 'webcoreui/styles' as *;
    @include setup((
        fontRegular: '/fonts/Inter-Regular.woff2',
        fontBold: '/fonts/Inter-Bold.woff2'
    ));
body {
	height: 160vh;
	background: radial-gradient(circle at top, #131013, #070707);;
}
</style>

